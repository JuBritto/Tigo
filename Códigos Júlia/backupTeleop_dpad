#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Joy
from std_msgs.msg import Float64MultiArray

class MarsupialUnifiedNode(Node):

    def __init__(self):
        super().__init__('marsupial_unified_node')
        
        # Subscritor para o comando do comando físico
        self.subscription = self.create_subscription(
            Joy,
            '/joy',
            self.joy_callback,
            10)
            
        # Publicador para as velocidades dos motores
        self.motor_publisher = self.create_publisher(Float64MultiArray, '/velocidade_motores', 10)
        
        # Parâmetros mecânicos (Podes alterar estes valores se o teu robô for diferente)
        self.r = 0.05  # Raio das rodas em metros (5cm)
        self.L = 0.30  # Distância entre rodas esquerda e direita (30cm)
        
        # Velocidades máximas configuradas para o D-Pad
        self.linear_speed_step = 0.6   # m/s
        self.angular_speed_step = 1.2  # rad/s
        
        self.get_logger().info('Nó Unificado Marsupial Inicializado com Sucesso!')

    def joy_callback(self, msg):
        # Captura os eixos do D-Pad (Ajustar índices se o comando for diferente)
        dpad_x = msg.axes[6] 
        dpad_y = msg.axes[7] 
        
        vx = 0.0
        wz = 0.0
        
        if dpad_y > 0.1:
            vx = self.linear_speed_step
        elif dpad_y < -0.1:
            vx = -self.linear_speed_step

        if dpad_x > 0.1:
            wz = self.angular_speed_step   # Esquerda
        elif dpad_x < -0.1:
            wz = -self.angular_speed_step  # Direita

        # Cálculo da Cinemática Inversa Diferencial
        omega_esq = (vx - (wz * self.L) / 2.0) / self.r
        omega_dir = (vx + (wz * self.L) / 2.0) / self.r
        
        # Publica o array com as velocidades dos motores [Esq1, Esq2, Dir1, Dir2]
        motor_msg = Float64MultiArray()
        motor_msg.data = [omega_esq, omega_esq, omega_dir, omega_dir]
        self.motor_publisher.publish(motor_msg)
        
        self.get_logger().info(f'Vx: {vx:.2f} Wz: {wz:.2f} -> Motores Esq: {omega_esq:.2f} | Dir: {omega_dir:.2f}')

# ATENÇÃO: Esta função DEVE estar encostada à margem esquerda, totalmente fora da classe!
def main(args=None):
    rclpy.init(args=args)
    node = MarsupialUnifiedNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
