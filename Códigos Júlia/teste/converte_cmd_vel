#!/usr/bin/env python3
"""
Nó ROS2: recebe geometry_msgs/Twist em /cmd_vel e envia ao Arduino
a string:  V,vx,vy,wz\n   (vx, vy em m/s | wz em rad/s)

Uso:
  python3 cmd_vel_serial.py
  python3 cmd_vel_serial.py --ros-args -p port:=/dev/ttyUSB0 -p baudrate:=115200
"""

import time

import rclpy
import serial
from geometry_msgs.msg import Twist
from rclpy.node import Node


class CmdVelSerial(Node):
    def __init__(self):
        super().__init__('cmd_vel_serial')

        # Parâmetros ajustáveis
        self.declare_parameter('port', '/dev/ttyACM0')
        self.declare_parameter('baudrate', 115200)
        self.declare_parameter('topic', 'cmd_vel')
        self.declare_parameter('send_rate', 20.0)    # Hz
        self.declare_parameter('cmd_timeout', 0.5)   # s sem cmd_vel -> envia zero

        port = self.get_parameter('port').value
        baud = self.get_parameter('baudrate').value
        topic = self.get_parameter('topic').value
        rate = self.get_parameter('send_rate').value
        self.cmd_timeout = self.get_parameter('cmd_timeout').value

        # Abre a serial
        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
        except serial.SerialException as e:
            self.get_logger().error(f'Não foi possível abrir {port}: {e}')
            raise

        time.sleep(2.0)  # o Arduino reinicia ao abrir a serial
        self.get_logger().info(f'Serial aberta em {port} @ {baud}')

        # Último comando recebido
        self.vx = 0.0
        self.vy = 0.0
        self.wz = 0.0
        self.last_cmd_time = time.monotonic()

        self.create_subscription(Twist, topic, self.cmd_vel_callback, 10)
        self.create_timer(1.0 / rate, self.send_timer_callback)

    def cmd_vel_callback(self, msg: Twist):
        self.vx = msg.linear.x
        self.vy = msg.linear.y
        self.wz = msg.angular.z
        self.last_cmd_time = time.monotonic()

    def send_timer_callback(self):
        # Se parou de receber cmd_vel, manda zero
        if time.monotonic() - self.last_cmd_time > self.cmd_timeout:
            self.vx = self.vy = self.wz = 0.0

        linha = f'V,{self.vx:.3f},{self.vy:.3f},{self.wz:.3f}\n'
        try:
            self.ser.write(linha.encode('ascii'))
        except serial.SerialException as e:
            self.get_logger().error(f'Erro ao escrever na serial: {e}')

    def destroy_node(self):
        # Para o robô ao encerrar
        try:
            self.ser.write(b'V,0.000,0.000,0.000\n')
            self.ser.close()
        except Exception:
            pass
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = CmdVelSerial()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
