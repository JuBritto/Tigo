import rclpy
from rclpy.node import Node
from std_msgs.msg import String
import serial
import sys
import termios
import tty
import time

class KeyboardSerialNode(Node):
    def __init__(self):
        super().__init__('keyboard_serial_node')
        # Ajuste a porta serial do Arduino
        self.ser = serial.Serial('/dev/ttyUSB0', 115200, timeout=1)
        time.sleep(2)  # espera Arduino reiniciar

        self.get_logger().info("Use W/A/S/D para movimentar, X para parar, Q para sair.")
        self.run_keyboard_loop()

    # Captura tecla sem precisar apertar enter
    def getch(self):
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        return ch

    def run_keyboard_loop(self):
        try:
            while rclpy.ok():
                key = self.getch().lower()
                if key == 'q':
                    break
                if key in ['w', 'a', 's', 'd', 'x']:
                    self.ser.write(key.encode())
                    self.get_logger().info(f"Enviado para Arduino: {key}")
        finally:
            self.ser.close()
            self.get_logger().info("Serial fechada, nó encerrado.")

def main(args=None):
    rclpy.init(args=args)
    node = KeyboardSerialNode()
    node.destroy_node()
    rclpy.shutdown()

if __name__ == "__main__":
    main()
